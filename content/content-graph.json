  "challenges": {
    "contact-form-delivers": {
      "number": 1,
      "handle": "does-your-contact-form-actually-deliver",
      "title": "Does your contact form actually deliver?",
      "guide": "claude-code-playwright-website-testing",
      "lab": "conversion-functionality",
      "module": "regression-plan",
      "publish": "2026-09-17",
      "criteria": [
        "A test submission with a unique marker was sent from a phone, not only from a desktop",
        "The marked message arrived in the inbox or system a human actually reads, and the time between send and arrival was recorded",
        "The confirmation the visitor sees was checked against what actually happened (a 'Thanks' shown only after a successful response, or the gap noted)",
        "The failure case was tried: a required field left empty produced a visible error instead of a success message",
        "The result, the evidence and the date are recorded somewhere you will find next month"
      ],
      "file": "01-contact-form-delivers.html",
      "summary": "Prove your contact form delivers: a marked submission from a phone, the inbox timestamp, the empty-field case, and a record you will find next month.",
      "seo": "Weekly Website Fix #1: prove your contact form delivers with a marked test from a phone, check the failure case, and record the evidence. Fifteen minutes."
    },
    "cta-goes-where-promised": {
      "number": 2,
      "handle": "does-your-main-call-to-action-go-where-its-label-promises",
      "title": "Does your main call to action go where its label promises?",
      "guide": "claude-code-landing-page-audit",
      "lab": "conversion-functionality",
      "module": "landing-validation",
      "publish": "2026-09-24",
      "criteria": [
        "The primary call to action on the page that matters most was identified by its label, not by its position",
        "Its final destination after redirects was recorded and compared with what the label promises",
        "The destination was checked on a phone: the promised thing is visible without hunting",
        "Every other button or link whose label is a promise (Book, Buy, Download, Start) was listed with its destination",
        "Mismatches were fixed where the label lives or where the destination lives — and re-checked afterwards"
      ],
      "file": "02-cta-goes-where-promised.html",
      "summary": "Every button is a promise. Check the primary call to action's real destination on a phone, list every promise-shaped label, and fix the ones that are not kept.",
      "seo": "Weekly Website Fix #2: check that your main call to action lands where its label promises, on a phone, after redirects — and fix the mismatches."
    },
    "reverse-last-deployment": {
      "number": 3,
      "handle": "can-you-safely-reverse-your-last-deployment",
      "title": "Can you safely reverse your last deployment?",
      "guide": "claude-code-github-actions-cloudflare",
      "lab": "launch-readiness",
      "module": "maintenance-checklist",
      "publish": "2026-10-01",
      "criteria": [
        "The last deployment is identified: what changed, when, and the exact previous version (commit, theme, release) it replaced",
        "The rollback steps are written down as commands or clicks, not as 'roll back'",
        "The rollback was rehearsed on a non-production copy, or the platform's rollback was performed and undone during a quiet window",
        "The rollback is known not to erase data created since the deploy (orders, submissions, content), or the gap is written down",
        "Someone other than you could execute the rollback from the notes alone"
      ],
      "file": "03-reverse-last-deployment.html",
      "summary": "Take the last deployment you made and prove you can reverse it: the exact previous version, the steps as commands, a rehearsal, and the data question answered.",
      "seo": "Weekly Website Fix #3: identify your last deployment, write the rollback as commands, rehearse it off production, and answer what happens to data."
    },
    "claude-md-matches-project": {
      "number": 4,
      "handle": "does-your-claude-md-match-the-real-project",
      "title": "Does your CLAUDE.md match the real project?",
      "guide": "production-claude-md-web-development",
      "lab": "website-operations",
      "module": "claude-md-section",
      "publish": "2026-10-08",
      "criteria": [
