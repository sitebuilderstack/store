{%- comment -%}
  Product demonstration.

  There is no recorded video yet. Rather than ship a broken player or a fake
  play button over a still, this section renders one of two states:

    · video_url set   → a real <video> with a poster, captions track, preload
                        metadata only, and a transcript link
    · video_url blank → the contents of the download, laid out as the walkthrough
                        it will eventually narrate, with an honest line saying the
                        recording is not published yet

  The second state is not a placeholder. It is the same information the video
  will carry, in a form that works today, is crawlable, and costs nothing to
  load. Nothing here implies a video exists when one does not.

  See docs/growth/PRODUCT-DEMO-SCRIPT.md for the shot list and the exact file
  to drop in.
{%- endcomment -%}

<section class="sbs-section" id="{{ section.settings.anchor | default: 'demo' }}">
  <div class="sbs-container">
    <header class="sbs-demo__head">
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="sbs-lede">{{ section.settings.body | escape }}</p>
      {%- endif -%}
    </header>

    {%- if section.settings.video_url != blank -%}
      <div class="sbs-demo__player">
        <video
          controls
          preload="metadata"
          playsinline
          width="1280" height="720"
          {% if section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 1280 }}"{% endif %}
          aria-describedby="sbs-demo-desc">
          <source src="{{ section.settings.video_url }}" type="video/mp4">
          {%- if section.settings.captions_url != blank -%}
            <track kind="captions" src="{{ section.settings.captions_url }}"
                   srclang="en" label="English" default>
          {%- endif -%}
          <p>Your browser cannot play this video.
             <a href="{{ section.settings.video_url }}">Download it instead</a>.</p>
        </video>
        <p id="sbs-demo-desc" class="sbs-demo__note">
          {{ section.settings.video_description | escape }}
          {%- if section.settings.transcript_url != blank -%}
            <a href="{{ section.settings.transcript_url }}">Read the transcript</a>.
          {%- endif -%}
        </p>
      </div>
    {%- else -%}
      <div class="sbs-demo__walkthrough">
        <ol class="sbs-demo__steps">
          {%- for block in section.blocks -%}
            <li class="sbs-demo__step" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.title | escape }}</h3>
              <p>{{ block.settings.body | escape }}</p>
              {%- if block.settings.code != blank -%}
                <pre><code>{{ block.settings.code }}</code></pre>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ol>
        {%- comment -%}
          A div, not a p: the setting is richtext and arrives wrapped in its
          own <p> tags. Inside a <p> the browser closed the outer element at
          the first inner one, leaving an empty dashed box above the note on
          every product page and the note itself unstyled below it.
        {%- endcomment -%}
        {%- if section.settings.pending_note != blank -%}
          <div class="sbs-demo__pending">{{ section.settings.pending_note }}</div>
        {%- endif -%}
        {%- comment -%}
          A real, complete workflow from inside the product, free and ungated.
          Not an excerpt with the useful half removed — the sample pages say so
          explicitly, and that claim is only worth making if it is true.
        {%- endcomment -%}
        {%- if section.settings.sample_url != blank -%}
          <p class="sbs-demo__sample">
            <a class="sbs-btn sbs-btn--ghost" href="{{ section.settings.sample_url }}"
               data-sbs-track="product_sample_viewed">
              {{ section.settings.sample_label | default: 'Read a full workflow from it, free' | escape }}
            </a>
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "SBS — Demo",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "demo" },
    { "type": "text", "id": "heading", "label": "Heading",
      "default": "See the Launch System in action" },
    { "type": "textarea", "id": "body", "label": "Intro" },
    { "type": "header", "content": "Video" },
    { "type": "paragraph",
      "content": "Leave the URL empty until a real recording exists. With it empty the section renders the written walkthrough below instead — no player, no fake play button." },
    { "type": "url", "id": "video_url", "label": "Video file URL (MP4)" },
    { "type": "image_picker", "id": "poster", "label": "Poster image" },
    { "type": "url", "id": "captions_url", "label": "Captions file (WebVTT)" },
    { "type": "url", "id": "transcript_url", "label": "Transcript page" },
    { "type": "text", "id": "video_description", "label": "Description under the player",
      "default": "A three-minute walkthrough of the download, from START-HERE to a finished build." },
    { "type": "header", "content": "Written walkthrough (shown when there is no video)" },
    { "type": "richtext", "id": "pending_note", "label": "Note under the walkthrough" },
    { "type": "header", "content": "Free sample" },
    { "type": "url", "id": "sample_url", "label": "Sample workflow URL" },
    { "type": "text", "id": "sample_label", "label": "Sample link label",
      "default": "Read a full workflow from it, free" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "body", "label": "Body" },
        { "type": "textarea", "id": "code", "label": "Code / file listing" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [{ "name": "SBS — Demo" }]
}
{% endschema %}
