<footer class="sbs-footer">
  <div class="sbs-container">
    <div class="sbs-footer__grid">
      <div>
        <a class="sbs-logo" href="{{ routes.root_url }}">
          <span class="sbs-logo__mark" aria-hidden="true">{{ section.settings.logo_mark | escape }}</span>
          <span>{{ section.settings.logo_text | default: shop.name | escape }}</span>
        </a>
        {%- if section.settings.blurb != blank -%}
          <div class="sbs-muted" style="margin-top: var(--sp-4); font-size: var(--step--1);">
            {{ section.settings.blurb }}
          </div>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'column' -%}
          <div {{ block.shopify_attributes }}>
            <h2>{{ block.settings.heading | escape }}</h2>
            <ul>
              {%- for i in (1..10) -%}
                {%- assign label_key = 'label_' | append: i -%}
                {%- assign url_key = 'url_' | append: i -%}
                {%- assign label = block.settings[label_key] -%}
                {%- assign url = block.settings[url_key] -%}
                {%- if label != blank and url != blank -%}
                  <li><a href="{{ url }}">{{ label | escape }}</a></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="sbs-footer__legal">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. All rights reserved.</p>
      {%- if section.settings.disclaimer != blank -%}
        {{ section.settings.disclaimer }}
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "SBS — Footer",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
