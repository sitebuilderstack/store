{%- comment -%}
  Restrained guides teaser for the lower homepage. Sits after the FAQ so it
  does not compete with the buy section. Reads the blog by handle from a
  setting; renders nothing at all if that blog has no articles, so an empty
  or renamed blog cannot leave a stranded heading on the homepage.
{%- endcomment -%}

{%- assign guides = blogs[section.settings.blog_handle] -%}

{%- if guides != blank and guides.articles_count > 0 -%}
  <section class="sbs-section" id="{{ section.settings.anchor | default: 'guides' | escape }}">
    <div class="sbs-container">
      <div class="sbs-section-head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="sbs-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.intro != blank -%}
          <p class="sbs-lede">{{ section.settings.intro | escape }}</p>
        {%- endif -%}
      </div>

      <ul class="sbs-grid sbs-grid--3">
        {%- assign shown = 0 -%}
        {%- for a in guides.articles -%}
          {%- if shown < section.settings.count -%}
            {%- assign shown = shown | plus: 1 -%}
            <li class="sbs-card">
              <h3><a href="{{ a.url }}">{{ a.title | escape }}</a></h3>
              {%- if a.excerpt != blank -%}
                <p>{{ a.excerpt | strip_html | truncate: 140 }}</p>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      <p class="sbs-guides__all">
        <a href="{{ guides.url }}">{{ section.settings.all_label | escape }}</a>
      </p>

      {%- comment -%}
        Direct links to the individual free resources, not only to the hub.

        The homepage is the most frequently recrawled URL on the site, so a page
        linked from here is one hop from the strongest crawl signal available.
        Linking only the hub put each resource two hops away behind a page that
        was itself not yet indexed.
      {%- endcomment -%}
      {%- if section.blocks.size > 0 -%}
        <div class="sbs-guides__resources">
          {%- if section.settings.resources_heading != blank -%}
            <h3>{{ section.settings.resources_heading | escape }}</h3>
          {%- endif -%}
          <ul>
            {%- for block in section.blocks -%}
              {%- if block.settings.url != blank and block.settings.label != blank -%}
                <li {{ block.shopify_attributes }}>
                  <a class="sbs-tap" href="{{ block.settings.url }}">{{ block.settings.label | escape }}</a>
                  {%- if block.settings.note != blank -%}
                    <span>{{ block.settings.note | escape }}</span>
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "SBS — Guides",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "guides" },
    { "type": "text", "id": "blog_handle", "label": "Blog handle", "default": "guides",
      "info": "The handle of the blog to read. Renders nothing if it has no articles." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Free guides" },
    { "type": "text", "id": "heading", "label": "Heading",
      "default": "The methodology, written up in full" },
    { "type": "textarea", "id": "intro", "label": "Intro",
      "default": "The workflow behind the Launch System is documented publicly. Read it first and decide for yourself whether the packaged version is worth it." },
    { "type": "range", "id": "count", "label": "Guides to show",
      "min": 2, "max": 6, "step": 1, "default": 5 },
    { "type": "text", "id": "all_label", "label": "Link label",
      "default": "Read all the guides" },
    { "type": "header", "content": "Free resources" },
    { "type": "text", "id": "resources_heading", "label": "Heading",
      "default": "And five checklists you can take away" }
  ],
  "blocks": [
    {
      "type": "resource",
      "name": "Resource",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "url", "label": "URL" },
        { "type": "text", "id": "note", "label": "Note" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "SBS — Guides" }]
}
{% endschema %}
