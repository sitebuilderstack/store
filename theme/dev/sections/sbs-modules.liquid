<section class="sbs-section sbs-section--alt" id="{{ section.settings.anchor | default: 'included' | escape }}">
  <div class="sbs-container">
    <div class="sbs-section-head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="sbs-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.intro != blank -%}
        <p class="sbs-lede">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </div>

    <ul class="sbs-grid sbs-grid--3">
      {%- for block in section.blocks -%}
        <li class="sbs-card sbs-module" {{ block.shopify_attributes }}>
          <span class="sbs-module__num">{{ block.settings.number | escape }}</span>
          <h3>{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.body | escape }}</p>
          {%- if block.settings.meta != blank -%}
            <div class="sbs-module__meta">{{ block.settings.meta | escape }}</div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "SBS — Modules",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "included",
      "info": "Used by in-page links, e.g. #included." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What you get" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Seventeen modules, one system" },
    { "type": "textarea", "id": "intro", "label": "Intro",
      "default": "Every count below is real and verifiable against the files you receive. The manifest inside the download lists them." }
  ],
  "blocks": [
    {
      "type": "module",
      "name": "Module",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "01" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "body", "label": "Description" },
        { "type": "text", "id": "meta", "label": "Meta line",
          "info": "File counts or contents. Must be accurate." }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [{ "name": "SBS — Modules" }]
}
{% endschema %}
